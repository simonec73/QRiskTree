<Window x:Class="QRiskTreeEditor.SecondaryWindows.SinglePassword"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QRiskTreeEditor.SecondaryWindows"
        mc:Ignorable="d"
        Title="Insert password" Height="150" Width="390" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="26"/>
            <RowDefinition Height="30"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Label Content="Please insert the password" Grid.Row="0" Margin="4,0,4,0"/>
        <PasswordBox x:Name="_password" Grid.Row="1" Margin="8,0,8,4"/>
        <Button x:Name="_ok" Content="OK" Height="20" Grid.Row="2" Width="45" HorizontalAlignment="Left" Margin="140,10,0,10" Click="_ok_Click"/>
        <Button x:Name="_cancel" Content="Cancel" Grid.Row ="2" Margin="0,10,140,10" IsCancel="True" HorizontalAlignment="Right" Width="45" Height="20"/>
    </Grid>
</Window>
