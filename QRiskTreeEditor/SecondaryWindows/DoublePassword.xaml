<Window x:Class="QRiskTreeEditor.SecondaryWindows.DoublePassword"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QRiskTreeEditor.SecondaryWindows"
        mc:Ignorable="d"
        Title="Define Password" Height="240" Width="390" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="26"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="26"/>
            <RowDefinition Height="30"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Label Content="Please insert the password" Grid.Row="0" Margin="4,0,4,0"/>
        <PasswordBox x:Name="_password" Grid.Row="1" Margin="8,0,8,4" PasswordChanged="_password_PasswordChanged"/>
        <ProgressBar x:Name="_passwordQuality" Grid.Row="2" Margin="8,4,8,4" Background="#FFE6E6E6" Foreground="Blue"/>
        <Label Content="Please repeat the password" Grid.Row="3" Margin="4,0,4,0"/>
        <PasswordBox x:Name="_passwordRepeat" Grid.Row="4" Margin="8,0,8,4" PasswordChanged="_passwordRepeat_PasswordChanged"/>
        <Button x:Name="_ok" Content="OK" IsDefault="True" Height="20" Grid.Row="5" Width="45" HorizontalAlignment="Left" Margin="146,10,0,10" Click="_ok_Click" IsEnabled="False"/>
        <Button x:Name="_cancel" Content="Cancel" Grid.Row ="5" Margin="0,10,146,10" IsCancel="True" HorizontalAlignment="Right" Width="45" Height="20"/>
    </Grid>
</Window>
